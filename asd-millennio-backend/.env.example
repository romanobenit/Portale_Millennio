# ============================================================
# ASD Millennio — .env.example
# Copia questo file in .env e compila i valori reali.
# NON committare il file .env su git.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/millennio

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Keycloak
# realm fisso: millennio-asd
# ------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=millennio-asd
KEYCLOAK_CLIENT_ID=millennio-backend
KEYCLOAK_CLIENT_SECRET=

# ------------------------------------------------------------
# Stripe
# STRIPE_WEBHOOK_SECRET: generato da "stripe listen --forward-to ..."
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# Blockchain — Polygon
# POLYGON_CHAIN_ID: 80002 (Amoy testnet) | 137 (Polygon PoS mainnet)
# MINTER_PRIVATE_KEY: mai committare su git — usare KMS in produzione
# ------------------------------------------------------------
POLYGON_RPC_URL=
POLYGON_CHAIN_ID=80002
CONTRACT_ADDRESS_PALASIRIO_NFT=
MINTER_PRIVATE_KEY=

# ------------------------------------------------------------
# Polygonscan API (V2)
# https://docs.polygonscan.com
# ------------------------------------------------------------
POLYGONSCAN_API_KEY=

# ------------------------------------------------------------
# IPFS / Pinata
# ------------------------------------------------------------
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# ------------------------------------------------------------
# Wallet custodiale soci (AES-256-GCM)
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
WALLET_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Email transazionali — Resend
# ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@millennioasd.com

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
HETZNER_API_TOKEN=

# ------------------------------------------------------------
# Business logic
# ------------------------------------------------------------
FUNDRAISING_TARGET_EUR=300000
ANNO_SPORTIVO_CORRENTE=2026-2027
TESSERA_SCADENZA_MESE=6
TESSERA_SCADENZA_GIORNO=30
CALENDARIO_INIZIO=2027-01-01
CALENDARIO_FINE=2042-12-31

# ------------------------------------------------------------
# Docker / Keycloak separati
# KEYCLOAK_DB: database separato per Keycloak (non usare lo stesso dell'app)
# KEYCLOAK_CMD: 'start-dev' in dev, 'start' in produzione
# KEYCLOAK_ADMIN_PASSWORD: cambiare prima del deploy!
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD_IN_PRODUZIONE
POSTGRES_DB=millennio
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD_IN_PRODUZIONE
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_CMD=start-dev
